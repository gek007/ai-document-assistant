OPENAI_API_KEY=sk-your-key-here
DOCUMENTS_DIR=./documents
OPENAI_MODEL=gpt-4o
MAX_AGENT_ITERATIONS=10
MAX_FILE_SIZE_KB=100

# OpenAI traces (visible at platform.openai.com → Logs)
OPENAI_STORE_TRACES=true
OPENAI_PROJECT_ID=   # optional: set to proj_xxx from platform.openai.com → Settings → Projects

# Logging
LOG_LEVEL=INFO
LOG_OUTPUT=both   # available values: terminal, file, both
LOG_DIR=./logs
LOG_MAX_FILES=10
LOG_MAX_SIZE_MB=10